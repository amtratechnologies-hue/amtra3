# Application
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Set to true when the API runs behind a trusted reverse proxy
TRUST_PROXY=false

# General API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Contact form rate limiting
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# Gmail SMTP delivery
# Create a Google App Password for the sending Gmail account:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=amtratechnologies@gmail.com

# Never commit a real App Password. Paste it only into server/.env.
SMTP_PASS=

# Public company address shown to visitors and used in client-facing emails.
CONTACT_PUBLIC_EMAIL=amtratechnologies@gmail.com

# Private inbox that receives project inquiries.
# Server-side only. Never expose this address in frontend code or client emails.
CONTACT_RECEIVER_EMAIL=alirazachakrani090@gmail.com

# Send the visitor an acknowledgement after the internal inquiry is delivered
# Set to false to disable client acknowledgement emails.
CONTACT_SEND_ACKNOWLEDGEMENT=true
