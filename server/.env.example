# Application
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/amtra
# Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/amtra?retryWrites=true&w=majority

# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173

# Set to true when the API runs behind a trusted reverse proxy
TRUST_PROXY=false

# General API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Contact form rate limiting
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
