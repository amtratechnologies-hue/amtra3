# Application
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Set to true when the API runs behind a trusted reverse proxy
TRUST_PROXY=false

# MongoDB (required for service requests and the admin panel)
# Use a dedicated database user with the least privileges it needs.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Optional. Used only when MONGODB_URI does not include a database name.
MONGODB_DB_NAME=amtra

# General API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Contact form rate limiting
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# Gmail SMTP delivery
# Create a Google App Password for the sending Gmail account:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=amtratechnologies@gmail.com

# Never commit a real App Password. Paste it only into server/.env.
SMTP_PASS=

# Public company address shown to visitors.
CONTACT_PUBLIC_EMAIL=amtratechnologies@gmail.com

# Private inbox that receives new-request notifications.
# Server-side only. Never expose this address in frontend code or client emails.
CONTACT_RECEIVER_EMAIL=amtratechnologies@gmail.com

# Admin bootstrap account
# These are used only by the seed script / optional startup seed.
ADMIN_USERNAME=amtratechnologies123
ADMIN_INITIAL_PASSWORD=

# Set to true only while creating the initial administrator, then set it back
# to false. The seed is idempotent and never overwrites an existing password.
ADMIN_SEED_ENABLED=false

# Session security (required in production)
# Generate a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
ADMIN_SESSION_TTL_MS=28800000

# Admin session cookie
ADMIN_COOKIE_NAME=amtra_admin_sid
ADMIN_COOKIE_PATH=/api/v1/admin
# lax is recommended when the frontend and API share a site. Use none + secure
# only when they are on different sites.
ADMIN_COOKIE_SAME_SITE=lax
# Defaults to true when NODE_ENV=production or SameSite=None.
ADMIN_COOKIE_SECURE=false

# Admin login rate limiting (failed attempts only)
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX=10
