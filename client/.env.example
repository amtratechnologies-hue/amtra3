# Base URL of the AMTRA API, including the version prefix.
# Leave blank during local development to use the Vite proxy at /api/v1
# (the proxy forwards to http://localhost:5000, the backend port).
# For a separately hosted API, set the full URL, for example:
# VITE_API_URL=https://api.example.com/api/v1
VITE_API_URL=

# Public production URL of the website, without a trailing slash.
# Used for canonical URLs and to generate sitemap.xml and robots.txt at build time.
# Example: https://www.amtratechnologies.com
VITE_SITE_URL=
